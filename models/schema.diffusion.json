{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atomic Chat diffusion model catalog",
  "description": "Curated local image/video generation families for stable-diffusion.cpp (and, later, the diffusers sidecar). Every size is the exact byte count from the Hugging Face API: the app renders bytes / 1024**3, so a hand-typed decimal GB would disagree with the progress bar beside it. A video family (modality video) also carries a video block; its side files may include audio_vae and a text_encoders entry with field embeddings_connectors.",
  "type": "object",
  "required": ["schema_version", "updated_at", "families"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/family" }
    }
  },
  "definitions": {
    "file": {
      "type": "object",
      "required": ["repo", "filename", "bytes"],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string",
          "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$"
        },
        "filename": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "field": {
          "type": "string",
          "enum": ["llm", "llm_vision", "qwen2vl", "clip_l", "t5xxl", "embeddings_connectors"]
        }
      }
    },
    "quant": {
      "type": "object",
      "required": ["id", "label", "filename", "bytes"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "pattern": "^[A-Z0-9_]+$" },
        "filename": { "type": "string", "minLength": 1 },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recommended": { "type": "boolean" }
      }
    },
    "family": {
      "type": "object",
      "required": [
        "id",
        "name",
        "modality",
        "engines",
        "transformer",
        "defaults",
        "ranges",
        "capabilities"
      ],
      "if": { "properties": { "modality": { "const": "video" } } },
      "then": { "required": ["video"] },
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "z-image",
            "flux.2-klein",
            "flux.1",
            "flux.1-uncensored",
            "flux.1-abliterated",
            "flux.1-nsfw-realism",
            "flux.1-krea",
            "krea-2-turbo",
            "qwen-image",
            "qwen-image-2.1",
            "wan2.2-ti2v-5b",
            "ltx-2"
          ]
        },
        "name": { "type": "string" },
        "developer": { "type": "string" },
        "description": { "type": "string" },
        "license": { "type": "string" },
        "gated": { "type": "boolean" },
        "modality": { "type": "string", "enum": ["image", "video"] },
        "engines": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "enum": ["sdcpp", "diffusers"] }
        },
        "transformer": {
          "type": "object",
          "required": ["repo", "quants"],
          "additionalProperties": false,
          "properties": {
            "repo": { "type": "string" },
            "quants": {
              "type": "array",
              "minItems": 1,
              "items": { "$ref": "#/definitions/quant" }
            }
          }
        },
        "vae": { "$ref": "#/definitions/file" },
        "vae_format": { "type": "string", "enum": ["flux2"] },
        "audio_vae": { "$ref": "#/definitions/file" },
        "text_encoders": {
          "type": "array",
          "items": { "$ref": "#/definitions/file" }
        },
        "defaults": {
          "type": "object",
          "required": ["steps", "cfg_scale", "width", "height"],
          "additionalProperties": false,
          "properties": {
            "steps": { "type": "integer", "minimum": 1 },
            "cfg_scale": { "type": "number", "minimum": 0 },
            "guidance": { "type": "number", "minimum": 0 },
            "sampling_method": { "type": "string" },
            "flow_shift": { "type": "number" },
            "width": { "type": "integer", "minimum": 64 },
            "height": { "type": "integer", "minimum": 64 },
            "sigmas": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "number", "exclusiveMinimum": 0, "maximum": 1 },
              "description": "A distilled model's fixed sigma schedule; sent as custom_sigmas when steps equals its length."
            }
          }
        },
        "video": {
          "type": "object",
          "description": "Required for a video family: the frame rate, the frame lattice k*frame_step+frame_offset, the default count, the inclusive range and the sizes the model was trained for.",
          "required": ["fps", "frame_step", "frame_offset", "frames", "frame_range", "resolution_presets"],
          "additionalProperties": false,
          "properties": {
            "fps": { "type": "integer", "minimum": 1 },
            "frame_step": { "type": "integer", "minimum": 1 },
            "frame_offset": { "type": "integer", "minimum": 0 },
            "frames": { "type": "integer", "minimum": 1 },
            "frame_range": {
              "type": "array",
              "items": { "type": "integer", "minimum": 1 },
              "minItems": 2,
              "maxItems": 2
            },
            "resolution_presets": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "array",
                "items": { "type": "integer", "minimum": 64 },
                "minItems": 2,
                "maxItems": 2
              }
            }
          }
        },
        "ranges": {
          "type": "object",
          "required": ["steps", "dims", "dim_multiple"],
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 2,
              "maxItems": 2
            },
            "dims": {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 2,
              "maxItems": 2
            },
            "dim_multiple": { "type": "integer", "minimum": 1 }
          }
        },
        "capabilities": {
          "type": "object",
          "required": ["negative_prompt", "guidance", "workflows"],
          "additionalProperties": false,
          "properties": {
            "negative_prompt": { "type": "boolean" },
            "guidance": { "type": "boolean" },
            "workflows": {
              "type": "array",
              "items": {
                "type": "string",
                "enum": ["create", "transform", "reference", "edit"]
              }
            }
          }
        }
      }
    }
  }
}
