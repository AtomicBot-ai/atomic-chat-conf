{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atomic Chat audio model catalog (deprecated export)",
  "description": "DEPRECATED compatibility export: models/audio.json is generated from models/catalog.json for released clients. Edit catalog.json and regenerate; retain the export while its consumers are supported. Legacy contract: Curated local speech, music and sound-effect models for audio.cpp. Clients read it from conf; the core takes family, task and options in each load request.",
  "deprecated": true,
  "type": "object",
  "required": ["schema_version", "updated_at", "models"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "type": "integer", "const": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/model" }
    }
  },
  "definitions": {
    "options": {
      "type": "object",
      "additionalProperties": { "type": ["string", "number", "boolean"] }
    },
    "quant": {
      "type": "object",
      "required": ["id", "label", "path", "filename", "bytes", "sha256"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "label": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "pattern": "^[A-Za-z0-9._/-]+\\.gguf$", "description": "Path in the repository at `revision`." },
        "filename": { "type": "string", "pattern": "^[A-Za-z0-9._-]+\\.gguf$", "description": "File under <data>/audio/models/." },
        "bytes": { "type": "integer", "minimum": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "recommended": { "type": "boolean" }
      }
    },
    "model": {
      "type": "object",
      "required": ["id", "name", "developer", "icon", "description", "license", "attribution", "mode", "engines", "family", "task", "repo", "revision", "quants", "controls", "defaults"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9.-]+$" },
        "name": { "type": "string", "minLength": 1 },
        "developer": { "type": "string", "minLength": 1 },
        "icon": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$",
          "description": "The developer's mark: a logo key clients resolve, such as qwen or stability."
        },
        "description": { "type": "string", "minLength": 1, "maxLength": 80, "description": "One line in a model picker." },
        "license": { "type": "string", "minLength": 1 },
        "attribution": {
          "type": ["string", "null"],
          "description": "Text clients must show with the model when its license asks for it."
        },
        "mode": { "enum": ["speech", "music", "effects"] },
        "engines": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": { "enum": ["audio-cpp"] }
        },
        "family": { "type": "string", "pattern": "^[a-z0-9_]+$" },
        "task": { "enum": ["tts", "gen"] },
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "revision": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "Full immutable Hugging Face commit SHA."
        },
        "quants": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/quant" }
        },
        "load_options": { "$ref": "#/definitions/options" },
        "session_options": { "$ref": "#/definitions/options" },
        "default_request_options": { "$ref": "#/definitions/options" },
        "default_voice": {
          "type": ["string", "null"],
          "description": "A built-in voice for a model that cannot speak without one."
        },
        "controls": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["voice", "speed", "language", "instruct", "lyrics", "durationSec", "bpm", "steps", "negativePrompt", "seed"]
          }
        },
        "defaults": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationSec": { "type": "number", "exclusiveMinimum": 0 },
            "seed": { "type": "integer", "minimum": 0 },
            "speed": { "type": "number", "exclusiveMinimum": 0 },
            "bpm": { "type": "integer", "minimum": 1 }
          }
        },
        "ranges": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "durationSec": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": { "type": "number", "exclusiveMinimum": 0 }
            }
          }
        }
      }
    }
  }
}
