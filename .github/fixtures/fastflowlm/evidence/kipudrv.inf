[DestinationDirs]
IpuMcdmDriver.Miniport = 13 ; Driver store
IpuMcdmDriver.Dpu = 13, DPU_Sequence ; Driver store/DPU_Sequence
IpuMcdmDriver.Elf = 13, ELF ; Driver store/ELF
IpuMcdmDriver.Mobilenet = 13, Mobilenet ; Driver store/Mobilenet
IpuMcdmDriver.UserModeAMD = 11 , AMD ; System32/AMD
IpuMcdmDriver.CopyMisc = 11
IpuMcdmDriver.CopyXclbin = 11,AMD

[Manufacturer]
%ManufacturerName%=IpuMcdmDriver.Mfg,NTamd64.10.0...22000

[ControlFlags]
ExcludeFromSelect=*


[IpuMcdmDriver.NT]
FeatureScore=FB
AddReg = IpuMcdmDriver.AddReg
CopyFiles=IpuMcdmDriver.Miniport, IpuMcdmDriver.CopyMisc, IpuMcdmDriver.CopyXclbin, IpuMcdmDriver.Dpu, IpuMcdmDriver.UserModeAMD, IpuMcdmDriver.Elf, IpuMcdmDriver.Mobilenet

[IpuMcdmDriver.NT.HW]
Include = machine.inf
Needs = PciD3ColdSupported.HW
AddReg = IPUHW.AddReg

