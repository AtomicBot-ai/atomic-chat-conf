<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Kept identical to Atomic Chat's src-tauri/Entitlements.plist: the
         mirrored binary replaces the one the app used to re-sign locally, so
         granting anything extra here would widen what the shipped app allows. -->
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <!-- llama-server dlopens ggml-*.dylib by name; Hardened Runtime blocks
         that without this. -->
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
</dict>
</plist>
