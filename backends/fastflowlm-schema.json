{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "releases"
  ],
  "properties": {
    "$schema": {
      "type": "string",
      "minLength": 1
    },
    "schema_version": {
      "const": 1
    },
    "releases": {
      "type": "array",
      "minItems": 0,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "version",
          "upstream_commit",
          "atomic_revision",
          "local_only_protocol",
          "min_core_version",
          "published_at",
          "provenance",
          "assets"
        ],
        "properties": {
          "version": {
            "type": "string",
            "pattern": "^flm-(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)-r[1-9][0-9]*$"
          },
          "upstream_commit": {
            "type": "string",
            "pattern": "^[0-9a-f]{40}$"
          },
          "atomic_revision": {
            "type": "integer",
            "minimum": 1
          },
          "local_only_protocol": {
            "const": 1
          },
          "min_core_version": {
            "type": "string",
            "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)$"
          },
          "published_at": {
            "type": "string",
            "format": "date-time"
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "core_commit",
              "patch_sha256",
              "dependencies_sha256",
              "document"
            ],
            "properties": {
              "core_commit": {
                "type": "string",
                "pattern": "^[0-9a-f]{40}$"
              },
              "patch_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "dependencies_sha256": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              },
              "document": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "url",
                  "size",
                  "sha256"
                ],
                "properties": {
                  "url": {
                    "type": "string",
                    "pattern": "^https://github\\.com/AtomicBot-ai/atomic-chat-core/releases/download/[^/?#]+/[^/?#]+$"
                  },
                  "size": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "sha256": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "assets": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "platform",
                "url",
                "size",
                "sha256"
              ],
              "properties": {
                "platform": {
                  "enum": [
                    "win-x64-npu",
                    "linux-x64-npu"
                  ]
                },
                "url": {
                  "type": "string",
                  "pattern": "^https://github\\.com/AtomicBot-ai/atomic-chat-core/releases/download/[^/?#]+/[^/?#]+$"
                },
                "size": {
                  "type": "integer",
                  "minimum": 1
                },
                "sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              }
            }
          }
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Atomic managed FastFlowLM builds",
  "description": "Only local-only Atomic builds. Releases sorted by upstream numeric semver, then numeric Atomic revision, descending. Empty until core build and live qualification."
}
